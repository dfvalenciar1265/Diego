  if(!value||typeof value!=='object')return false;const v=value as PublicAvailability;
  if(v.query?.arrival!==q.arrival||v.query?.departure!==q.departure||v.query?.guests!==q.guests||!Array.isArray(v.apartments)||v.apartments.length!==slugs.length)return false;
  if(!['ready','unconfigured','unavailable','stale','incomplete'].includes(v.sourceStatus))return false;
